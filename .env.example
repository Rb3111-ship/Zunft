# Copy to supabase/functions/.env for local dev, or set with `supabase secrets set`.
# These stay server-side (Edge Function only). Never put them in the Flutter app.
GEMINI_API_KEY=
# Low-cost model to start with; change here without a code change.
LLM_MODEL=gemini-3.5-flash-lite
DEEPGRAM_API_KEY=
# Optional: only set if a web client must call the function. The mobile app does not need CORS.
ALLOWED_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
